{
    "name": "@teages/oxc-blank-space",
    "description": "A type-stripper that blanks TypeScript-only syntax using the oxc parser, preserving line and column positions.",
    "version": "0.1.0",
    "license": "Apache-2.0",
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist"
    ],
    "engines": {
        "node": ">=18.0.0"
    },
    "scripts": {
        "build": "tsup",
        "test": "bun test",
        "typecheck": "tsc --noEmit",
        "lint": "biome check .",
        "lint:fix": "biome check --write .",
        "prepack": "pnpm build"
    },
    "dependencies": {
        "oxc-parser": "0.134.0"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.0",
        "@types/bun": "^1.2.0",
        "ts-blank-space": "^0.9.0",
        "tsup": "^8.0.0",
        "typescript": "^5.9.0"
    }
}
