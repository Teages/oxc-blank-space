{
  "name": "@teages/oxc-blank-space",
  "type": "module",
  "version": "0.2.0",
  "packageManager": "pnpm@11.1.2",
  "description": "A type-stripper that blanks TypeScript-only syntax using the oxc parser, preserving line and column positions.",
  "license": "Apache-2.0",
  "repository": "Teages/oxc-blank-space",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./experimental-native": {
      "types": "./dist/native.d.mts",
      "import": "./dist/native.mjs"
    }
  },
  "module": "./dist/index.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/index.d.mts"
      ],
      "./experimental-native": [
        "./dist/native.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "obuild && pnpm build:native",
    "build:native": "cd native && napi build --platform --release --output-dir ../dist",
    "play:prepare": "obuild --stub",
    "play": "pnpm -C playground play",
    "dev": "vitest dev",
    "lint": "eslint --cache .",
    "lint:fix": "eslint --cache --fix .",
    "prepack": "pnpm build",
    "test": "pnpm lint && pnpm test:types && vitest run --coverage",
    "test:types": "tsc --noEmit --skipLibCheck",
    "bench": "vitest bench --run"
  },
  "dependencies": {
    "oxc-parser": "^0.148.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@napi-rs/cli": "^3.9.0",
    "@types/node": "^24.12.4",
    "@vitest/coverage-v8": "^4.1.6",
    "eslint": "^10.3.0",
    "jiti": "2.7.0",
    "obuild": "^0.4.35",
    "ts-blank-space": "^0.9.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  },
  "publishConfig": {
    "access": "public"
  }
}
